# 1. Fichiers d'environnement et secrets (mots de passe de base de données, clés API)
.env
config/local.php

# 2. Dossiers de dépendances externes (trop lourds, ils s'installent via des commandes)
vendor/
node_modules/

# 3. Fichiers temporaires et journaux d'erreurs locaux
*.log

# 4. Fichiers importés par les utilisateurs dans ton application (ex: fichiers CSV d'étudiants)
assets/uploads/*
!assets/uploads/.gitkeep

# 5. Fichiers cachés générés automatiquement par ton système (Windows/Linux/Mac) ou ton éditeur
.DS_Store
Thumbs.db
.vscode/
.idea/